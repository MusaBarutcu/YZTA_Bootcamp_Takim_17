# CarbOn ortam değişkenleri — kopyalayıp .env olarak kaydedin
# LLM anahtarları OPSIYONELDIR; boş bırakılırsa yerleşik kural tabanlı koç çalışır.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# Opsiyonel: Climatiq'ten canlı ulaşım katsayısı (boşsa yerel DEFRA tablosu)
CLIMATIQ_API_KEY=

# Uygulama
CARBON_DB_PATH=carbon.db
CARBON_DAILY_BUDGET_KG=15.0
PORT=8000
